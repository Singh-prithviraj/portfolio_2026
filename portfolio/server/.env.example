PORT=5000

# Optional: set this to use MongoDB instead of the bundled profile.json.
# After setting it, run `npm run seed` once to load profile.json into Mongo.
MONGO_URI=

# --- Contact form email (Gmail) ---
# EMAIL_USER: the Gmail address that SENDS the notification (usually your own).
# EMAIL_PASS: a 16-character Gmail "App Password" — NOT your normal Gmail password.
#             Generate one at https://myaccount.google.com/apppasswords
#             (requires 2-Step Verification to be turned on for your Google account).
# CONTACT_TO: optional — where messages get delivered. Defaults to EMAIL_USER.
EMAIL_USER=
EMAIL_PASS=
CONTACT_TO=
